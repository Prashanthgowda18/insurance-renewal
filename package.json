{
  "name": "insurance-reminder-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix backend run prisma:generate",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend run start",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "dev:frontend": "npm --prefix frontend run dev -- --port 3000",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
